# ============================================================
# Techo 360 - Worker de chatbot - variables de entorno
# ------------------------------------------------------------
# Copia como ".env" (nunca se sube a git). El instalador
# (install-worker.ps1) genera este archivo automaticamente --
# esta plantilla es solo referencia / instalacion manual.
# ============================================================

# --- UNICO valor pensado para cambiar entre esta prueba y el
#     despliegue final de laboratorio: hoy es la IP de Tailscale
#     del VPS (100.116.197.118). Cuando RabbitMQ escuche en la red
#     privada de la universidad (tarea futura, NO esta), este es el
#     unico valor que cambia -- usuario/password/puerto se mantienen. ---
RABBITMQ_HOST=100.116.197.118

# --- Fijos: mismos para todos los workers del pool ---
RABBITMQ_PORT=5672
RABBITMQ_USER=techo360-worker
RABBITMQ_PASSWORD=cambia-esta-contrasena
OLLAMA_MODEL=techo360-chatbot:v3.2

# Prioridad alta (10) para que RabbitMQ prefiera este worker sobre el
# consumer de respaldo del VPS (prioridad 0). No cambiar salvo que se
# quiera que este worker especifico ceda prioridad a otro.
CHATBOT_CONSUMER_PRIORITY=10
